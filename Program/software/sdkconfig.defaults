# ── 目标/板级（与 Embedded_debug_tool 同板：Waveshare ESP32-S3-Touch-LCD-2）──
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ── PSRAM 8MB 八线 80MHz：摄像头帧缓冲必须在 PSRAM，不开则 esp_camera 直接失败 ──
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED=80
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP_SLEEP_PSRAM_LEAKAGE_WORKAROUND=y
CONFIG_STDATOMIC_S32C1I_SPIRAM_WORKAROUND=y

# ── 控制台/日志：UVC 模式下 USB 内部 PHY 归 USB-OTG，USB-Serial/JTAG 必须让出 ──
# ESP32-S3 的 USB-Serial/JTAG 与 USB-OTG 共用一个内部 PHY，二者只能用一个。
# 日志改走 UART0(IO43/IO44)：板上没引到 USB 口，PC 侧看不到（要看得接 UART-TTL）。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ── USB UVC 摄像头（USB-OTG 设备：TinyUSB + usb_device_uvc，已 vendor 到 components/）──
# 枚举成标准 UVC 摄像头，PC 侧无需驱动/私有协议，scripts/uvc_view.py 直接看实时画面。
CONFIG_TINYUSB_RHPORT_FS=y
CONFIG_TUSB_VID=0x303A
CONFIG_TUSB_PID=0x8000
CONFIG_TUSB_MANUFACTURER="Espressif"
CONFIG_TUSB_PRODUCT="ESP32-S3 OV5640 UVC BULK"
CONFIG_FORMAT_MJPEG_CAM1=y
# 传输模式：Bulk（官方 README 表格：ISO ~512KB/s，Bulk ~1216KB/s，Bulk 在 Windows/MacOS 可用）。
# 实测 ISO 下 VGA@30 的 MJPEG 带宽超过 512KB/s → 主机只收到截断帧 → MSMF 抓不到任何一帧
# （opencv 报 0/30 帧；DirectShow 直接开不了）。Bulk 另外自带流控：主机不取就 NAK，
# 天然限速，不会像 ISO 那样"设备以为发成功了、主机其实没收到"。
CONFIG_UVC_MODE_BULK_CAM1=y
# 默认档 VGA@30
CONFIG_FRAMESIZE_VGA=y
CONFIG_UVC_CAM1_FRAMERATE=60
CONFIG_UVC_CAM1_FRAMESIZE_WIDTH=640
CONFIG_UVC_CAM1_FRAMESIZE_HEIGT=480
# 再挂 3 个可选档：QVGA@30 / HVGA@30 / HD@15（PC 侧可自选）
CONFIG_UVC_CAM1_MULTI_FRAMESIZE=y
CONFIG_UVC_MULTI_FRAME_WIDTH_1=320
CONFIG_UVC_MULTI_FRAME_HEIGHT_1=240
CONFIG_UVC_MULTI_FRAME_FPS_1=30
CONFIG_UVC_MULTI_FRAME_WIDTH_2=480
CONFIG_UVC_MULTI_FRAME_HEIGHT_2=320
CONFIG_UVC_MULTI_FRAME_FPS_2=30
CONFIG_UVC_MULTI_FRAME_WIDTH_3=1280
CONFIG_UVC_MULTI_FRAME_HEIGHT_3=720
CONFIG_UVC_MULTI_FRAME_FPS_3=15

# ── SD 卡（SPI2 + FatFs）。注意：摄像头 OV5640 不占 SPI2（见 camera/drv_camera.h 引脚表）──
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_ENABLE_EXFAT=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y

# ── esp32-camera：传感器支持保持组件默认（OV2640/OV3660/OV5640… 全开）。
# 这是**故意的**：摄像头探测靠 SCCB 地址 + PID，全开时若实际插的是别的型号
# （本板 FPC 常见 OV2640 与 OV5640 互换），固件会直接打印 "Detected OVxxx camera"；
# 只留 OV5640 则会退化成 "Camera not detected"，把型号信息藏掉，不利于排查。

# SCCB（摄像头 I2C）用 IDF 新 I2C 主机驱动；本工程不初始化其它 I2C 设备，端口无冲突
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
CONFIG_SCCB_HARDWARE_I2C_PORT1=y
CONFIG_SCCB_CLK_FREQ=100000

CONFIG_CAMERA_PSRAM_DMA=y
