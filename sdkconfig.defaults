# ── 目标/板级（与 Embedded_debug_tool 同板：Waveshare ESP32-S3-Touch-LCD-2）──
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ── PSRAM 8MB 八线 80MHz：摄像头帧缓冲必须在 PSRAM，不开则 esp_camera 直接失败 ──
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED=80
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP_SLEEP_PSRAM_LEAKAGE_WORKAROUND=y
CONFIG_STDATOMIC_S32C1I_SPIRAM_WORKAROUND=y

# ── 控制台/日志：主 console = 原生 USB-Serial/JTAG（板上 USB 口，即 COM14）──
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ── SD 卡（SPI2 + FatFs）。注意：摄像头 OV5640 不占 SPI2（见 camera/drv_camera.h 引脚表）──
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_ENABLE_EXFAT=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y

# ── esp32-camera：传感器支持保持组件默认（OV2640/OV3660/OV5640… 全开）。
# 这是**故意的**：摄像头探测靠 SCCB 地址 + PID，全开时若实际插的是别的型号
# （本板 FPC 常见 OV2640 与 OV5640 互换），固件会直接打印 "Detected OVxxx camera"；
# 只留 OV5640 则会退化成 "Camera not detected"，把型号信息藏掉，不利于排查。

# SCCB（摄像头 I2C）用 IDF 新 I2C 主机驱动；本工程不初始化其它 I2C 设备，端口无冲突
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
CONFIG_SCCB_HARDWARE_I2C_PORT1=y
CONFIG_SCCB_CLK_FREQ=100000
